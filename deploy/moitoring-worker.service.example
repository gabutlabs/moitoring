[Unit]
Description=Moitoring collector and alert worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moitoring
Group=moitoring
WorkingDirectory=/var/lib/moitoring
ExecStart=/usr/local/bin/moitoring worker --config /etc/moitoring/config.ini
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moitoring

[Install]
WantedBy=multi-user.target
