[server]
# Use 0.0.0.0 for direct network access; keep loopback behind a reverse proxy.
host = 127.0.0.1
port = 8080
# Set false to keep the API available without serving the browser UI.
web_ui_enabled = true
# Enable when browsers access the application over HTTPS.
secure_cookies = false
# List only trusted reverse proxy IPs/CIDRs; leave empty when there is no proxy.
trusted_proxies =

[database]
path = ./data/moitoring.db

[admin]
username = admin
email = admin@example.local
password = replace-this-before-use
is_changed_password = true

[monitoring]
# Applies to RabbitMQ queues and configured systemd units.
poll_interval = 60s

[rabbitmq]
url = http://127.0.0.1:15672
username = monitoring
password = replace-this-with-a-read-only-rabbitmq-password
virtual_hosts = /
expected_queues = 
# When set, monitor only these queue names in every configured virtual host.
# Leave empty to retain all-queue monitoring.
excluded_queues =
history_retention = 24h

[systemd]
units =
# Example: targets = worker-a|jobs.service|active, ops@worker-b|billing.service|inactive
targets =
ssh_identity_file =
ssh_known_hosts =

[smtp]
host = mail.example.local
port = 587
username = monitoring@example.local
password = replace-this-with-an-smtp-password
from = monitoring@example.local
starttls = true

[alerts]
recipients = ops@example.local
reminder_interval = 24h
